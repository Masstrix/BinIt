{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, in-game overlay and update window",
  "windows": ["main", "overlay", "updater"],
  "permissions": ["core:default", "core:window:allow-start-dragging",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-is-maximized", "core:window:allow-close"]
}
