{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bin It",
  "identifier": "app.binit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bin It",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "dragDropEnabled": false,
        "backgroundColor": "#0D1224",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:7878 ws://127.0.0.1:7878; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRjVGRkZFMkEyQjQ1MzcKUldRM1JTc3Evdi8xZkhySVZjSkNDY2dEYVArL0dSRnlkYm9laGczN1VLUkpKTHNTS2tSYVlXQ3IK",
      "endpoints": ["https://github.com/Masstrix/BinIt/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
